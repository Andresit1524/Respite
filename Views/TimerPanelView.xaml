<UserControl
    x:Class="Respite.Views.TimerPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <!--  Tarjeta Pomodoro Compacta  -->
        <Border
            Margin="0,0,0,10"
            Padding="12"
            Background="#1E293B"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,0,2" Orientation="Horizontal">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#F8FAFC"
                            Text="🍅 Pomodoro" />
                        <TextBlock
                            Margin="6,0,0,0"
                            FontSize="11"
                            Foreground="#94A3B8"
                            Text="{Binding PomodoroStatus}" />
                    </StackPanel>
                    <TextBlock
                        FontSize="26"
                        FontWeight="Bold"
                        Foreground="#F43F5E"
                        Text="{Binding PomodoroDisplay}" />
                </StackPanel>

                <!--  Botones Pomodoro  -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Width="68"
                        Height="30"
                        Margin="0,0,6,0"
                        Background="#E11D48"
                        BorderThickness="0"
                        Command="{Binding StartPomodoroCommand}"
                        Content="Iniciar"
                        Cursor="Hand"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#FFFFFF">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button
                        Width="68"
                        Height="30"
                        Background="#334155"
                        BorderThickness="0"
                        Command="{Binding StopPomodoroCommand}"
                        Content="Detener"
                        Cursor="Hand"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#E2E8F0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Tarjeta Límite Continuo Compacta  -->
        <Border
            Padding="12"
            Background="#1E293B"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,0,2" Orientation="Horizontal">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#F8FAFC"
                            Text="🛡️ Límite PC" />
                        <TextBlock
                            Margin="6,0,0,0"
                            FontSize="11"
                            Foreground="#94A3B8"
                            Text="{Binding HardLimitStatus}" />
                    </StackPanel>
                    <TextBlock
                        FontSize="26"
                        FontWeight="Bold"
                        Foreground="#10B981"
                        Text="{Binding HardLimitDisplay}" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Width="90"
                    Height="30"
                    VerticalAlignment="Center"
                    Background="#334155"
                    BorderThickness="0"
                    Command="{Binding ResetHardLimitCommand}"
                    Content="Reiniciar"
                    Cursor="Hand"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#E2E8F0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>

