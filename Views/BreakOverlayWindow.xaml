<Window
    x:Class="Respite.Views.BreakOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Respite - Tiempo de Descanso"
    AllowsTransparency="True"
    Background="#D00F172A"
    ShowInTaskbar="False"
    Topmost="True"
    WindowState="Maximized"
    WindowStyle="None">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border
            MaxWidth="550"
            Padding="40"
            Background="#1E293B"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="16">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="#F8FAFC"
                    Text="¡Hora de un descanso!" />

                <TextBlock
                    Margin="0,0,0,24"
                    FontSize="15"
                    Foreground="#94A3B8"
                    Text="Has estado usando el PC durante bastante tiempo continuo. Despeja tu vista, estira las piernas y respira un momento."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <!--  Temporizador restante  -->
                <Border
                    Margin="0,0,0,24"
                    Padding="20,15"
                    HorizontalAlignment="Center"
                    Background="#0F172A"
                    CornerRadius="12">
                    <TextBlock
                        x:Name="TxtRemainingTime"
                        HorizontalAlignment="Center"
                        FontSize="42"
                        FontWeight="Bold"
                        Foreground="#38BDF8"
                        Text="10:00" />
                </Border>

                <!--  Botón aplazar de emergencia  -->
                <Button
                    x:Name="BtnPostpone"
                    Padding="16,8"
                    HorizontalAlignment="Center"
                    Background="#334155"
                    BorderThickness="0"
                    Click="BtnPostpone_Click"
                    Content="Aplazar 5 minutos"
                    Cursor="Hand"
                    Foreground="#E2E8F0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
