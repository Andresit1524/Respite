<Window
    x:Class="Respite.Views.BreakOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Respite - Tiempo de Descanso"
    AllowsTransparency="True"
    Background="#D00F172A"
    ShowInTaskbar="False"
    Topmost="True"
    WindowState="Maximized"
    WindowStyle="None">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border
            MaxWidth="550"
            Padding="40"
            Background="#1E293B"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="16">
            <StackPanel HorizontalAlignment="Center">
                <!--  Logotipo de Respite en Overlay  -->
                <Viewbox
                    Width="48"
                    Height="48"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center">
                    <Canvas Width="64" Height="64">
                        <Path
                            Fill="#059669"
                            Data="M45.111 11.076a13.198 13.093 0 0 1 .182 2.168 13.198 13.093 0 0 1-3.977 9.367 13.23 13.23 0 0 1 4.037 9.516 13.23 13.23 0 0 1-13.227 13.227 13.23 13.23 0 0 1-13.229-13.227 13.23 13.23 0 0 1 4.008-9.486 13.198 13.093 0 0 1-4.008-9.397 13.198 13.093 0 0 1 .205-2.3A24.69 24.69 0 0 0 7.305 32a24.693 24.693 0 0 0 24.693 24.693A24.693 24.693 0 0 0 56.691 32 24.69 24.69 0 0 0 45.11 11.076z" />
                        <Path
                            Fill="#F43F5E"
                            Data="M32.141 3.9a9.464 9.389 0 0 0-8.242 4.774 9.464 9.389 0 0 0-1.22 4.615 9.464 9.389 0 0 0 3.3 7.125 9.464 9.389 0 0 0 6.162 2.264 9.464 9.389 0 0 0 6.152-2.254 9.464 9.389 0 0 0 3.313-7.135 9.464 9.389 0 0 0-1.152-4.49A9.464 9.389 0 0 0 32.14 3.9" />
                    </Canvas>
                </Viewbox>

                <TextBlock
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="#F8FAFC"
                    Text="¡Hora de un descanso!" />

                <TextBlock
                    Margin="0,0,0,24"
                    FontSize="15"
                    Foreground="#94A3B8"
                    Text="Has estado usando el PC durante bastante tiempo continuo. Despeja tu vista, estira las piernas y respira un momento."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <!--  Temporizador restante  -->
                <Border
                    Margin="0,0,0,24"
                    Padding="20,15"
                    HorizontalAlignment="Center"
                    Background="#0F172A"
                    CornerRadius="12">
                    <TextBlock
                        x:Name="TxtRemainingTime"
                        HorizontalAlignment="Center"
                        FontSize="42"
                        FontWeight="Bold"
                        Foreground="#38BDF8"
                        Text="10:00" />
                </Border>

                <!--  Botón aplazar de emergencia  -->
                <Button
                    x:Name="BtnPostpone"
                    Padding="16,8"
                    HorizontalAlignment="Center"
                    Background="#334155"
                    BorderThickness="0"
                    Click="BtnPostpone_Click"
                    Content="Aplazar 5 minutos"
                    Cursor="Hand"
                    Foreground="#E2E8F0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
