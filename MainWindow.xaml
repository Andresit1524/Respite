<Window x:Class="Respite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Respite" 
        Height="540" 
        Width="780"
        MinHeight="480"
        MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="12" Height="12" Background="#10B981" CornerRadius="6" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="Respite" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                <TextBlock Text="— Cuidado visual y descansos conscientes" FontSize="14" Foreground="#94A3B8" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Pestañas Principales -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="16,8"/>
                    <Setter Property="Margin" Value="0,0,8,12"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="#1E293B" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#334155"/>
                                        <Setter Property="Foreground" Value="#38BDF8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Pestaña 1: Dashboard / Temporizadores -->
            <TabItem Header="Temporizadores">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tarjeta Pomodoro -->
                    <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Padding="24" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🍅 Pomodoro" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding PomodoroStatus}" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                            <Border Background="#0F172A" CornerRadius="12" Padding="28,14" Margin="0,0,0,24">
                                <TextBlock Text="{Binding PomodoroDisplay}" FontSize="48" FontWeight="Bold" Foreground="#F43F5E" HorizontalAlignment="Center"/>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Iniciar" 
                                        Command="{Binding StartPomodoroCommand}" 
                                        Width="100" Height="36" 
                                        Background="#E11D48" Foreground="#FFFFFF" 
                                        FontWeight="SemiBold" BorderThickness="0" Margin="0,0,10,0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="Detener" 
                                        Command="{Binding StopPomodoroCommand}" 
                                        Width="100" Height="36" 
                                        Background="#334155" Foreground="#E2E8F0" 
                                        FontWeight="SemiBold" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Tarjeta Límite Duro -->
                    <Border Grid.Column="2" Background="#1E293B" CornerRadius="12" Padding="24" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🛡️ Límite Continuo de PC" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding HardLimitStatus}" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                            <Border Background="#0F172A" CornerRadius="12" Padding="28,14" Margin="0,0,0,24">
                                <TextBlock Text="{Binding HardLimitDisplay}" FontSize="48" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center"/>
                            </Border>

                            <Button Content="Reiniciar Ciclo" 
                                    Command="{Binding ResetHardLimitCommand}" 
                                    Width="130" Height="36" 
                                    Background="#334155" Foreground="#E2E8F0" 
                                    FontWeight="SemiBold" BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Pestaña 2: Configuración -->
            <TabItem Header="Configuración">
                <Border Background="#1E293B" CornerRadius="12" Padding="28" BorderBrush="#334155" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,16,0">
                            <!-- Sección Pomodoro -->
                            <TextBlock Text="Ajustes de Pomodoro (minutos)" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,12"/>
                            
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tiempo de trabajo:" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding PomodoroWorkMinutes, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569" Padding="6,4" TextAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Descanso corto:" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding PomodoroShortBreakMinutes, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569" Padding="6,4" TextAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Descanso largo:" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding PomodoroLongBreakMinutes, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569" Padding="6,4" TextAlignment="Center"/>
                            </Grid>

                            <!-- Sección Límites Duros -->
                            <TextBlock Text="Límites Duros Automáticos" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Intervalo de trabajo continuo (máx. 180 min):" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding HardLimitIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569" Padding="6,4" TextAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Duración del descanso obligatorio (min):" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding HardLimitBreakMinutes, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569" Padding="6,4" TextAlignment="Center"/>
                            </Grid>

                            <!-- Sección Comportamiento del Sistema -->
                            <TextBlock Text="Comportamiento del Sistema" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,12"/>

                            <CheckBox Content="Iniciar Respite con Windows (Segundo plano)" 
                                      IsChecked="{Binding StartWithWindows}" 
                                      Foreground="#CBD5E1" Margin="0,0,0,10"/>

                            <CheckBox Content="Minimizar a la bandeja del sistema al presionar 'Cerrar'" 
                                      IsChecked="{Binding MinimizeToTrayOnClose}" 
                                      Foreground="#CBD5E1" Margin="0,0,0,24"/>

                            <!-- Botón Guardar -->
                            <Button Content="Guardar Configuración" 
                                    Command="{Binding SaveSettingsCommand}" 
                                    HorizontalAlignment="Left"
                                    Width="180" Height="36" 
                                    Background="#059669" Foreground="#FFFFFF" 
                                    FontWeight="SemiBold" BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
