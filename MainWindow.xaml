<Window
    x:Class="Respite.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:Respite.Views"
    Title="Respite"
    Width="380"
    MaxHeight="580"
    SizeToContent="Height"
    AllowsTransparency="True"
    Background="Transparent"
    Deactivated="Window_Deactivated"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeChanged="Window_SizeChanged"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <!--  Contenedor Popup con sombra y bordes redondeados  -->
    <Border
        Margin="10"
        Padding="16"
        Background="#0F172A"
        BorderBrush="#334155"
        BorderThickness="1"
        CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="18"
                Opacity="0.45"
                ShadowDepth="4"
                Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Cabecera Superior  -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  Logotipo de la App externalizado desde Resources/Icons.xaml  -->
                    <Image
                        Width="22"
                        Height="22"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Source="{StaticResource RespiteLogoImage}" />

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#F8FAFC"
                        Text="Respite" />
                </StackPanel>

                <!--  Botones de acción superior derecha: Configuración y Cerrar Popup  -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  Botón de Configuración con SVG oficial externalizado  -->
                    <Button
                        Margin="0,0,6,0"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding ToggleSettingsCommand}"
                        Cursor="Hand"
                        ToolTip="Configuración">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="IconBorder"
                                    Width="30"
                                    Height="30"
                                    Background="#1E293B"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    CornerRadius="15">
                                    <Image
                                        Width="15"
                                        Height="15"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Source="{StaticResource SettingsIconImage}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="IconBorder" Property="Background" Value="#334155" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!--  Botón Ocultar  -->
                    <Button
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CloseButton_Click"
                        Cursor="Hand"
                        ToolTip="Ocultar">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="CloseBorder"
                                    Width="30"
                                    Height="30"
                                    Background="#1E293B"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    CornerRadius="15">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="#94A3B8"
                                        Text="✕" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseBorder" Property="Background" Value="#E11D48" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!--  Sub-vista 1: Panel de Temporizadores  -->
            <views:TimerPanelView Grid.Row="1" />

            <!--  Sub-vista 2: Panel de Configuración (Superpuesto)  -->
            <views:SettingsPanelView
                Grid.Row="1"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisConverter}}" />
        </Grid>
    </Border>
</Window>
