<Window
    x:Class="Respite.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Respite"
    Width="780"
    Height="540"
    MinWidth="680"
    MinHeight="480"
    Background="#0F172A"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Cabecera Superior: Título a la izquierda e Ícono de Configuración a la derecha  -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="24"
                FontWeight="Bold"
                Foreground="#F8FAFC"
                Text="Respite" />

            <!--  Botón de configuración (círculo SVG como ícono superior derecho)  -->
            <Button
                Grid.Column="1"
                Padding="0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding ToggleSettingsCommand}"
                Cursor="Hand"
                ToolTip="Configuración">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="IconBorder"
                            Width="36"
                            Height="36"
                            Background="#1E293B"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="18">
                            <Viewbox
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <!--  Círculo SVG como ícono provisional  -->
                                    <Ellipse
                                        Canvas.Left="3"
                                        Canvas.Top="3"
                                        Width="18"
                                        Height="18"
                                        Fill="#0F172A"
                                        Stroke="#38BDF8"
                                        StrokeThickness="2.5" />
                                    <Ellipse
                                        Canvas.Left="9"
                                        Canvas.Top="9"
                                        Width="6"
                                        Height="6"
                                        Fill="#38BDF8" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconBorder" Property="Background" Value="#334155" />
                                <Setter TargetName="IconBorder" Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!--  Panel Principal: Temporizadores (Visible por defecto)  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Tarjeta Pomodoro  -->
            <Border
                Grid.Column="0"
                Padding="28"
                Background="#1E293B"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="14">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock
                        Margin="0,0,0,6"
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="#F8FAFC"
                        Text="🍅 Pomodoro" />
                    <TextBlock
                        Margin="0,0,0,24"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="#94A3B8"
                        Text="{Binding PomodoroStatus}" />

                    <Border
                        Margin="0,0,0,28"
                        Padding="32,16"
                        Background="#0F172A"
                        CornerRadius="14">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="52"
                            FontWeight="Bold"
                            Foreground="#F43F5E"
                            Text="{Binding PomodoroDisplay}" />
                    </Border>

                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button
                            Width="110"
                            Height="40"
                            Margin="0,0,12,0"
                            Background="#E11D48"
                            BorderThickness="0"
                            Command="{Binding StartPomodoroCommand}"
                            Content="Iniciar"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Foreground="#FFFFFF">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button
                            Width="110"
                            Height="40"
                            Background="#334155"
                            BorderThickness="0"
                            Command="{Binding StopPomodoroCommand}"
                            Content="Detener"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Foreground="#E2E8F0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Tarjeta Límite Duro  -->
            <Border
                Grid.Column="2"
                Padding="28"
                Background="#1E293B"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="14">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock
                        Margin="0,0,0,6"
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="#F8FAFC"
                        Text="🛡️ Límite Continuo de PC" />
                    <TextBlock
                        Margin="0,0,0,24"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="#94A3B8"
                        Text="{Binding HardLimitStatus}" />

                    <Border
                        Margin="0,0,0,28"
                        Padding="32,16"
                        Background="#0F172A"
                        CornerRadius="14">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="52"
                            FontWeight="Bold"
                            Foreground="#10B981"
                            Text="{Binding HardLimitDisplay}" />
                    </Border>

                    <Button
                        Width="140"
                        Height="40"
                        Background="#334155"
                        BorderThickness="0"
                        Command="{Binding ResetHardLimitCommand}"
                        Content="Reiniciar Ciclo"
                        Cursor="Hand"
                        FontWeight="SemiBold"
                        Foreground="#E2E8F0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!--  Panel Desplegable / Modal de Configuración  -->
        <Grid Grid.Row="1" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border
                Padding="28"
                Background="#1E293B"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,16,0">
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="#F8FAFC"
                                Text="Configuración" />
                            <Button
                                Grid.Column="1"
                                Padding="12,6"
                                Background="#334155"
                                BorderThickness="0"
                                Command="{Binding ToggleSettingsCommand}"
                                Content="✕ Cerrar"
                                Cursor="Hand"
                                Foreground="#CBD5E1">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <!--  Sección Pomodoro  -->
                        <TextBlock
                            Margin="0,0,0,12"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="#38BDF8"
                            Text="Ajustes de Pomodoro (minutos)" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="#CBD5E1"
                                Text="Tiempo de trabajo:" />
                            <TextBox
                                Grid.Column="1"
                                Padding="6,4"
                                Background="#0F172A"
                                BorderBrush="#475569"
                                Foreground="#FFFFFF"
                                Text="{Binding PomodoroWorkMinutes, UpdateSourceTrigger=PropertyChanged}"
                                TextAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="#CBD5E1"
                                Text="Descanso corto:" />
                            <TextBox
                                Grid.Column="1"
                                Padding="6,4"
                                Background="#0F172A"
                                BorderBrush="#475569"
                                Foreground="#FFFFFF"
                                Text="{Binding PomodoroShortBreakMinutes, UpdateSourceTrigger=PropertyChanged}"
                                TextAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="#CBD5E1"
                                Text="Descanso largo:" />
                            <TextBox
                                Grid.Column="1"
                                Padding="6,4"
                                Background="#0F172A"
                                BorderBrush="#475569"
                                Foreground="#FFFFFF"
                                Text="{Binding PomodoroLongBreakMinutes, UpdateSourceTrigger=PropertyChanged}"
                                TextAlignment="Center" />
                        </Grid>

                        <!--  Sección Límites Duros  -->
                        <TextBlock
                            Margin="0,0,0,12"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="#38BDF8"
                            Text="Límites Duros Automáticos" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="#CBD5E1"
                                Text="Intervalo de trabajo continuo (máx. 180 min):" />
                            <TextBox
                                Grid.Column="1"
                                Padding="6,4"
                                Background="#0F172A"
                                BorderBrush="#475569"
                                Foreground="#FFFFFF"
                                Text="{Binding HardLimitIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                                TextAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="#CBD5E1"
                                Text="Duración del descanso obligatorio (min):" />
                            <TextBox
                                Grid.Column="1"
                                Padding="6,4"
                                Background="#0F172A"
                                BorderBrush="#475569"
                                Foreground="#FFFFFF"
                                Text="{Binding HardLimitBreakMinutes, UpdateSourceTrigger=PropertyChanged}"
                                TextAlignment="Center" />
                        </Grid>

                        <!--  Sección Comportamiento del Sistema  -->
                        <TextBlock
                            Margin="0,0,0,12"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="#38BDF8"
                            Text="Comportamiento del Sistema" />

                        <CheckBox
                            Margin="0,0,0,10"
                            Content="Iniciar Respite con Windows (Segundo plano)"
                            Foreground="#CBD5E1"
                            IsChecked="{Binding StartWithWindows}" />

                        <CheckBox
                            Margin="0,0,0,24"
                            Content="Minimizar a la bandeja del sistema al presionar 'Cerrar'"
                            Foreground="#CBD5E1"
                            IsChecked="{Binding MinimizeToTrayOnClose}" />

                        <!--  Botón Guardar  -->
                        <Button
                            Width="180"
                            Height="38"
                            HorizontalAlignment="Left"
                            Background="#059669"
                            BorderThickness="0"
                            Command="{Binding SaveSettingsCommand}"
                            Content="Guardar Configuración"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Foreground="#FFFFFF">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
